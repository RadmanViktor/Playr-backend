# Copy this file to ~/apps/playr-api.env on the server and fill in real values.
# This file is NOT committed to git (see .gitignore) - it lives only on the server.
# Referenced by /etc/systemd/system/playr-api.service via EnvironmentFile=
# and sourced by deploy/deploy-backend.sh for running EF Core migrations.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5258
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=playr;Username=playr;Password=CHANGE-ME
Jwt__Issuer=PLAYR
Jwt__Audience=PLAYR
Jwt__SigningKey=CHANGE-ME
Jwt__ExpirationMinutes=60
Steam__ApiKey=CHANGE-ME
Steam__SyncIntervalHours=12

# Persistent storage for uploaded files (avatars, post media, etc.)
# Must live OUTSIDE the dotnet publish output directory, since `dotnet publish`
# wipes and recreates that folder on every deploy.
FileStorage__RootPath=/home/viktor/apps/playr-uploads

