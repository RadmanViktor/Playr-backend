      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Playr.Application\Playr.Application.csproj" />
    <ProjectReference Include="..\Playr.Infrastructure\Playr.Infrastructure.csproj" />
  </ItemGroup>

</Project>
